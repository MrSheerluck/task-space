# Rust API
PORT=3000
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://taskspace:change-me-local-only@postgres:5432/taskspace
SYNC_EVENT_RETENTION_SECONDS=7776000
# Keep application tombstones and CRDT delete history for at least the same
# supported offline/recovery window before asynchronous compaction.
SYNC_TOMBSTONE_RETENTION_SECONDS=7776000
# Comma-separated exact browser origins. Set this explicitly in production
# (for example, https://app.example.com). If omitted, the server derives the
# origin from the configured WorkOS/Dodo callback URLs and still includes
# localhost development origins.
TASK_SPACE_ALLOWED_ORIGINS=http://localhost:8080
# Optional operator-only token for GET /internal/metrics. Leave unset to
# disable the endpoint.
TASK_SPACE_METRICS_TOKEN=

# WorkOS AuthKit
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_POST_LOGIN_REDIRECT_URI=http://localhost:8080/app
WORKOS_ISSUER=https://api.workos.com
# Set this to the exact access-token `iss`. In multi-application environments,
# WorkOS uses the environment's default application client id here.
WORKOS_TOKEN_ISSUER=https://api.workos.com/user_management/client_default_app
# Optional: set when the WorkOS access-token audience is configured.
WORKOS_AUDIENCE=
WORKOS_SESSION_COOKIE=task_space_session

# Dodo Payments
DODO_PAYMENTS_WEBHOOK_KEY=whsec_replace_me
DODO_PAYMENTS_API_KEY=dodo_test_replace_me
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:8080/app
DODO_PRO_MONTHLY_PRODUCT_ID=prod_replace_me_monthly
DODO_PRO_YEARLY_PRODUCT_ID=prod_replace_me_yearly
